<nav class="playbook-sidebar" aria-label="{{ playbookTitle }}">
  <p class="playbook-sidebar-title"><a href="/playbooks/{{ playbook }}/">{{ playbookTitle }}</a></p>

  {% set framework = siblings | filterBySection("framework") %}
  {% set artefacts = siblings | filterBySection("artefacts") %}

  <ol>
    {% for sibling in framework %}
      <li>
        <a href="{{ sibling.url }}"
           {% if sibling.url == page.url %}aria-current="page"{% endif %}>
          {{ sibling.data.title }}
        </a>
      </li>
    {% endfor %}
  </ol>

  {% if artefacts | length %}
  {% set artefactsUrl = "/playbooks/" + playbook + "/artefacts/" %}
  <p class="playbook-sidebar-group">
    <a href="{{ artefactsUrl }}"
       {% if page.url == artefactsUrl %}aria-current="page"{% endif %}>Artefacts</a>
  </p>
  <ol>
    {% for sibling in artefacts %}
      <li>
        <a href="{{ sibling.url }}"
           {% if sibling.url == page.url %}aria-current="page"{% endif %}>
          {{ sibling.data.title }}
        </a>
      </li>
    {% endfor %}
  </ol>
  {% endif %}
</nav>
