<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="describedby" href="/llms.txt" type="text/markdown">
  {% set pageDescription = description or summary or front or (page.rawInput | excerpt) or site.description %}
  {% set canonical = site.url + page.url %}
  {% if title and title != site.title %}
    {% if playbookTitle and title != playbookTitle %}
      {% set ogTitle = title + " - " + playbookTitle + " - " + site.title %}
    {% else %}
      {% set ogTitle = title + " - " + site.title %}
    {% endif %}
  {% else %}
    {% set ogTitle = site.title + " - " + site.tagline %}
  {% endif %}
  {% set ogImage = site.url + (image or site.ogImage) %}
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <title>{{ ogTitle if title and title != site.title else site.title }}</title>
  <link rel="preload" href="/fonts/plex-sans-5/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  {% set jsonLd = { url: page.url, title: title, description: pageDescription, updated: updated, date: date, playbook: playbook, playbookTitle: playbookTitle, parent: crumbParent, robots: robots, site: site } | structuredData %}
  {% if jsonLd %}<script type="application/ld+json">{{ jsonLd | safe }}</script>{% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {% include "partials/site-header.njk" %}
  <main id="main" tabindex="-1">
    {% include "partials/breadcrumbs.njk" %}
    {{ content | safe }}
  </main>
  {% include "partials/site-footer.njk" %}
  {% if site.gaId %}
  {% include "partials/consent-banner.njk" %}
  <script src="/js/consent.js" data-ga-id="{{ site.gaId }}" defer></script>
  {% endif %}
</body>
</html>
